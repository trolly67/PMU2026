<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registration_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView ... android:text="@string/label_full_name"/>
        <EditText
            android:id="@+id/fullNameInput"
        ... />

        <TextView ... android:text="@string/label_gender"/>
        <RadioGroup
            android:id="@+id/genderGroup"
        ... >
        <RadioButton android:id="@+id/maleRadio" ... />
        <RadioButton android:id="@+id/femaleRadio" ... />
    </RadioGroup>

    <TextView ... android:text="@string/label_course"/>
    <Spinner
        android:id="@+id/courseSpinner"
    ... />

    <TextView
        android:id="@+id/difficultyLabel"
        android:text="@string/label_difficulty_default" />
    <SeekBar
        android:id="@+id/difficultySeekBar"
        android:max="4"
        android:progress="0"
    ... />

    <TextView ... android:text="@string/label_birth_date"/>
    <CalendarView
        android:id="@+id/birthDateCalendar"
    ... />

    <Button
        android:id="@+id/submitButton"
        android:text="@string/button_submit"
    ... />

    <TextView
        android:id="@+id/resultText"
    ... />

</LinearLayout>
    </ScrollView>